# iOS llama.cpp build copy + CMake build dirs (ios/build-llama.sh)
ios/.build-llama/
# The same for ONNX Runtime GenAI (ios/build-onnx-genai.sh): both source trees'
# CMake builds, the assembled ort_home, the patched genai copy, and the Python
# venv its build scripts need.
ios/.build-onnx-genai/

