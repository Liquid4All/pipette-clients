*.log
adb.log

# IDEs and editors
.idea/
.vscode/

# OS files
.DS_Store

.pipette-*/
# The default workspace name `pipette init` creates. Covered separately from
# the suffixed ones above because it holds the client's identity keypair.
.pipette/

# Native build outputs the iOS build phases write (build-llama.sh, build-onnx-genai.sh)
ios/Pipette/Pipette/Generated/*
!ios/Pipette/Pipette/Generated/.gitkeep
# Track the generated build-info version stamps (but not the heavy build
# artifacts: static libraries, headers). These record the mlx-swift /
# mlx-swift-lm / swift-transformers pins and
# the onnxruntime / onnxruntime-genai pins the app reports as its
# runtime_version, as Swift for the app and as JSON for
# ios/release-manifest.py. Committing them means a forgotten regen
# after a dependency or submodule bump shows up as a diff, and CI's freshness
# check (git diff --exit-code) forces the correct version to be committed —
# otherwise a stale runtime_version ships and the collector can't recognize it.
!ios/Pipette/Pipette/Generated/MLX/
ios/Pipette/Pipette/Generated/MLX/*
!ios/Pipette/Pipette/Generated/MLX/MLXBuildInfo.swift
!ios/Pipette/Pipette/Generated/MLX/MLXBuildInfo.json
!ios/Pipette/Pipette/Generated/OnnxGenai/
ios/Pipette/Pipette/Generated/OnnxGenai/*
!ios/Pipette/Pipette/Generated/OnnxGenai/OnnxGenaiBuildInfo.swift
!ios/Pipette/Pipette/Generated/OnnxGenai/OnnxGenaiBuildInfo.json

# Signing material and private keys. These live in GitHub secrets and are
# materialized outside the checkout at build time; none belongs in the tree.
#
# The one deliberate exception is negated below: android/Pipette/debug.keystore
# is the shared public debug key (password `android`), committed so every machine
# and CI produce interchangeable debug builds. It is loaded by path from
# app/build.gradle.kts, so it has to stay tracked.
*.jks
*.keystore
!android/Pipette/debug.keystore
*.p12
*.pfx
*.pem
*.key
*.p8
*.mobileprovision

# Local environment files, the usual home for tokens during development.
# `.env.example` stays tracked: it names the variables without carrying values.
.env
.env.*
!.env.example

# Google Cloud service-account keys. These belong in GitHub secrets (the
# Firebase App Distribution and Play publisher credentials both live in the
# `firebase-distribution` environment), never in the tree. `gha-creds-*.json`
# is the file google-github-actions/auth writes into the workspace, which is
# the easiest one to stage by accident after a local `act` run.
*-sa.json
*service-account*.json
*serviceaccount*.json
gha-creds-*.json

# Firebase SDK config. Nothing reads it: App Distribution runs through the
# `firebase-tools` CLI with an explicit `--app` and service-account auth, so
# neither the `google-services` Gradle plugin nor this file is present. Ignored
# so it cannot come back by accident. Re-add both deliberately if the in-app
# App Distribution SDK is ever adopted, since that one does require them.
google-services.json

