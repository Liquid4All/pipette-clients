ios/Pipette/Config/*.local.xcconfig
# Written per-build by ci_scripts/ci_pre_xcodebuild.sh (and ios/build.sh --debug-ui)
# from the PIPETTE_DEBUG_UI flag; never authored by hand.
ios/Pipette/Config/*.generated.xcconfig

# Android and Gradle build artifacts
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/app/src/main/jniLibs/
android/local.properties
*.apk
*.aab

