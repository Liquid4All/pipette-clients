     }
 
+    // stage in chunks through one ggml_aligned_malloc buffer (vm_allocate on Apple) of at most 16 MiB,
+    // so no tensor-sized heap block is freed into malloc's deferred reclaim. check_tensors keeps the
+    // whole-tensor read, which validation needs.
+    struct staging_free {
+        size_t size;
+        void operator()(void * p) const { ggml_aligned_free(p, size); }
+    };
+    std::unique_ptr<void, staging_free> staging(nullptr, staging_free{0});
+    // CPU_REPACK buffers take a tensor only whole (their set_tensor asserts offset 0 and full size).
+    auto chunkable = [](const ggml_tensor * t) {
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(t->buffer);
+        return !ggml_backend_buft_is_host(buft) && strstr(ggml_backend_buft_name(buft), "REPACK") == nullptr;
+    };
+    if (!use_mmap && !check_tensors && !upload_backend) {
+        size_t n_staged = 0;
+        size_t n_largest = 0;
+        for (const ggml_tensor * cur : tensors) {
+            if (get_weight(ggml_get_name(cur)) == nullptr || lazy.has(cur) || !chunkable(cur)) {
+                continue;
+            }
+            n_staged++;
+            n_largest = std::max(n_largest, ggml_nbytes(cur));
+        }
+        if (n_largest > 0) {
+            // 16 MiB is a multiple of every page size, so each chunk but a tensor's last is one too
+            const size_t size = std::min(16*MiB, n_largest);
+            staging = std::unique_ptr<void, staging_free>(ggml_aligned_malloc(size), staging_free{size});
+            if (!staging) {
+                throw std::runtime_error(format("failed to allocate a %zu-byte staging buffer", size));
+            }
+            LLAMA_LOG_INFO("%s: bounded staging: %zu tensors through one %.2f MiB buffer (largest %.2f MiB)\n",
+                __func__, n_staged, size/1024.0/1024.0, n_largest/1024.0/1024.0);
+        }
+    }
+
     for (struct ggml_tensor * cur : tensors) {
         const auto * weight = get_weight(ggml_get_name(cur));
         if (weight == nullptr) {
