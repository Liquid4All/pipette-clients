#!/usr/bin/env bash
#
# Generated by cmake/cargo.cmake; do not edit the copy in the build dir.
# Exports the toolchain's cross env and forces `--target` so the cdylib matches
# the ABI of the CMake C/C++.

set -euo pipefail

export RUSTC="@RUSTC_EXECUTABLE@"
CARGO_TARGET="@PIPETTE_CARGO_TARGET@"

@PIPETTE_CARGO_ENV@

args=()
skip_next=false
target_was_replaced=false
for arg in "$@"; do
  if [ "$skip_next" = true ]; then
    skip_next=false
    continue
  fi
  # Both spellings must be caught, or a second --target is appended below and
  # cargo builds for two targets.
  case "$arg" in
    --target)
      if [ -n "${CARGO_TARGET:-}" ]; then
        skip_next=true
        args+=("--target" "$CARGO_TARGET")
        target_was_replaced=true
      else
        args+=("$arg")
      fi
      ;;
    --target=*)
      if [ -n "${CARGO_TARGET:-}" ]; then
        args+=("--target=$CARGO_TARGET")
        target_was_replaced=true
      else
        args+=("$arg")
      fi
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done
if [ -n "${CARGO_TARGET:-}" ] && [ "$target_was_replaced" = false ]; then
  args+=("--target" "$CARGO_TARGET")
fi

exec "@CARGO_EXECUTABLE@" "${args[@]}"
