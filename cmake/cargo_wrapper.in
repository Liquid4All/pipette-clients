#!/usr/bin/env bash
#
# Generated by cmake/cargo.cmake (configure_file) — DO NOT EDIT the copy in the
# build dir. Target-aware cargo wrapper: exports the toolchain's cross-compile
# env, then forces `--target @PIPETTE_CARGO_TARGET@` so the cdylib is built for
# the same ABI as the CMake C/C++.

set -euo pipefail

export RUSTC="@RUSTC_EXECUTABLE@"
CARGO_TARGET="@PIPETTE_CARGO_TARGET@"

# Toolchain-provided cross env (AR_/CC_/CXX_/CARGO_TARGET_*_LINKER).
@PIPETTE_CARGO_ENV@

# Force/normalize --target so callers don't have to thread the triple through.
args=()
skip_next=false
target_was_replaced=false
for arg in "$@"; do
  if [ "$skip_next" = true ]; then
    skip_next=false
    continue
  fi
  # Handle both cargo spellings: `--target <triple>` and `--target=<triple>`.
  # Missing either would leave target_was_replaced=false and append a SECOND
  # --target below, which cargo reads as a multi-target build.
  case "$arg" in
    --target)
      if [ -n "${CARGO_TARGET:-}" ]; then
        skip_next=true
        args+=("--target" "$CARGO_TARGET")
        target_was_replaced=true
      else
        args+=("$arg")
      fi
      ;;
    --target=*)
      if [ -n "${CARGO_TARGET:-}" ]; then
        args+=("--target=$CARGO_TARGET")
        target_was_replaced=true
      else
        args+=("$arg")
      fi
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done
if [ -n "${CARGO_TARGET:-}" ] && [ "$target_was_replaced" = false ]; then
  args+=("--target" "$CARGO_TARGET")
fi

exec "@CARGO_EXECUTABLE@" "${args[@]}"
