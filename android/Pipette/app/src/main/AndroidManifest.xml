<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Resumable model downloads run as a WorkManager foreground (data sync) worker. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Per-rep thermal-HAL sensor telemetry (device_android_thermal_sensors_*) is read
      in-process via `dumpsys thermalservice`, which requires DUMP. DUMP is
      signature|privileged|development, so it stays UNGRANTED (and harmless) on normal
      installs; on lab/benchmark devices it is enabled per-device with
      `adb shell pm grant ai.liquid.pipette android.permission.DUMP`. Declared here
      because `pm grant` only works for manifest-declared permissions. Sensor sampling
      is best-effort/fail-soft — the family is simply omitted when DUMP is not granted.
      tools:ignore silences the lint warning for this intentionally-declared signature perm.
    -->
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".PipetteApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Pipette">
        <!-- Compose launcher. The per-tab UI/UX is being ported from the iOS client. -->
        <activity
            android:name=".ComposeMainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pipette.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Legacy view-based launcher, disabled while the Compose rewrite lands.
             Re-enable by uncommenting and removing the intent-filter from ComposeMainActivity. -->
        <!--
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pipette"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        -->


        <!-- WorkManager's foreground service ships with no foregroundServiceType;
             merge in dataSync so the resumable-download worker can run as a
             foreground (data sync) service on Android 14+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Pause / Resume / Cancel from the download notification. -->
        <receiver
            android:name=".DownloadActionReceiver"
            android:exported="false" />

        <!-- Pocket-mode run screen, hosted in the :benchmark process. While it is
             the focused activity the framework classifies :benchmark as top-app,
             so inference regains the prime cores an OEM (e.g. Samsung) denies a
             non-top-app service process. -->
        <!-- configChanges: survive fold/unfold and rotation instead of being
             destroyed and recreated. On a foldable those fire constantly, and a
             recreation resets this screen's run-scoped state (e.g. a pending
             "Pausing…") while churning the very activity that is holding the
             process at top-app. The activity re-inflates itself in
             onConfigurationChanged, so density and layout changes still render
             correctly. -->
        <activity
            android:name=".BenchmarkActivity"
            android:process=":benchmark"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|layoutDirection|locale|fontScale"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Runs in the MAIN process (no android:process) for the length of a job.
             The pocket screen makes :benchmark the top activity, which leaves main
             with no foreground component and therefore cached, and the platform
             kills cached processes doing sustained binder traffic, which is exactly
             what JobRunner's progress mirror is. This keeps main out of that bucket.
             specialUse for the same reason as the engine service below: an
             on-device benchmark has no closer-fit FGS type. -->
        <service
            android:name=".service.JobOrchestratorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Coordinates an on-device LLM benchmark job while its run screen holds the foreground in another process" />
        </service>

        <!-- Isolated process that owns the native engine and the model's heap.
             specialUse: an on-device benchmark run is the foreground task the
             user started; it has no closer-fit FGS type. Killed when idle. -->
        <service
            android:name=".service.PipetteBenchmarkService"
            android:process=":benchmark"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs on-device LLM benchmarks in an isolated process to bound and reclaim model memory" />
        </service>

        <!-- Sentry crash/perf monitoring. The SDK auto-initializes from this DSN (no
             manual init needed), and BenchmarkCrashReporter reads the same meta-data to
             configure sentry-native in the `:benchmark` process, so this is the single
             source of truth for both.

             The value comes from defaultConfig.manifestPlaceholders in
             app/build.gradle.kts, NOT from a per-buildType block: both variants report to
             the same Sentry project and are separated by io.sentry.environment instead.
             Note that ${sentryEnvironment} below is the opposite, set per buildType, so
             the two placeholders are deliberately configured in different places.

             It is EMPTY unless the build supplies a Sentry DSN (sentry.dsn in
             local.properties, or SENTRY_DSN in the environment), which is what leaves
             reporting off in both processes: the SDK skips auto-init on an empty DSN, and
             BenchmarkCrashReporter.init returns early on a blank one. -->
        <meta-data android:name="io.sentry.dsn" android:value="${sentryDsn}" />

        <!-- Screenshot attachment is deliberately OFF: Settings renders the signed-in
             account's email and the feedback dialog pre-fills it, so a crash screenshot could
             carry an address nobody chose to send. Declared as an explicit false rather than
             omitted and left to the SDK default, so an SDK upgrade cannot quietly turn a
             privacy control back on. Deliberately without tools:replace: if a library manifest
             ever ships attach-screenshot=true, the merger fails on the conflict instead of one
             side silently winning, which is the signal we want here. -->
        <meta-data android:name="io.sentry.attach-screenshot" android:value="false" />

        <!-- Attach the view hierarchy to crashes. Safe to keep: ViewHierarchyNode has no text
             field. Per node the SDK serializes the class name, the resource-id name, geometry,
             alpha and visibility; the Compose exporter adds only a testTag/SentryTag. -->
        <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="true" />

        <!-- Performance tracing is DISABLED (sample-rate 0) — this app runs on-device
             LLM benchmarks and any tracing overhead would skew the measurements. Only
             crash/error reporting is active. User-interaction tracing is likewise off. -->
        <meta-data android:name="io.sentry.traces.sample-rate" android:value="0.0" />

        <!-- Environment: debug builds report under "debug" so dev/test events don't pollute
             production dashboards/alerts; release builds report under "production". The value
             comes from the buildType's manifestPlaceholders (see app/build.gradle.kts) and
             mirrors the iOS SentryConfiguration #if DEBUG environment. -->
        <meta-data android:name="io.sentry.environment" android:value="${sentryEnvironment}" />
    </application>

</manifest>
